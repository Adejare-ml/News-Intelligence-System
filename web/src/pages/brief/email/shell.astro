---
/**
 * The Morning Brief for readers who did not choose Business: masthead,
 * the sections slot and the footer. /api/send-brief fills the slot with
 * their chosen category sections, and rewrites the marked intro and source
 * lines when the email carries the week in business.
 */
import { lagosDate } from "../../../lib/edition.ts";
import { ink, muted, gold, rule, sans, serif, page, card, SECTIONS_SLOT } from "../../../components/email/theme.ts";

const site = (Astro.site?.toString() ?? "https://auranews.pages.dev/").replace(/\/$/, "") + import.meta.env.BASE_URL.replace(/\/$/, "");
const today = lagosDate(new Date());
const msoOpen = '<!--[if mso]><table role="presentation" width="600" align="center" cellpadding="0" cellspacing="0"><tr><td><![endif]-->';
const msoClose = "<!--[if mso]></td></tr></table><![endif]-->";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="aura-subject" content={`AURA Morning Brief · ${today}`} />
    <title>AURA Morning Brief</title>
  </head>
  <body style={`margin:0;padding:0;background:${page};`}>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style={`background:${page};`}>
      <tr><td align="center" style="padding:24px 12px;">
        <Fragment set:html={msoOpen} />
        <table role="presentation" width="600" cellpadding="0" cellspacing="0" style={`max-width:600px;width:100%;background:${card};border-radius:14px;`}>
          <tr><td style={`padding:32px 32px 8px;font:600 12px/1.4 ${sans};letter-spacing:2px;color:${gold};`}>AURA · THE MORNING BRIEF</td></tr>
          <tr><td style={`padding:0 32px;font:500 30px/1.15 ${serif};color:${ink};`}>{today}</td></tr>
          <tr><td style={`padding:10px 32px 16px;font:15px/1.6 ${sans};color:${muted};`}><Fragment set:html="<!--aura:intro-->" />The headlines you chose, from the outlets that reported them.<Fragment set:html="<!--/aura:intro-->" /></td></tr>
          <Fragment set:html={SECTIONS_SLOT} />
          <tr><td style={`padding:20px 32px 28px;font:12px/1.6 ${sans};color:${muted};border-top:1px solid ${rule};`}>
            <Fragment set:html="<!--aura:source-->" />Headlines are collected automatically from Google News; each links to the outlet that published it.<Fragment set:html="<!--/aura:source-->" />
            You get this because you subscribed at {site.replace(/^https?:\/\//, "")}.{" "}
            <a href="{{preferences_url}}" style={`color:${muted};`}>Change topics</a>{" · "}
            <a href="{{unsubscribe_url}}" style={`color:${muted};`}>Unsubscribe</a>.
          </td></tr>
        </table>
        <Fragment set:html={msoClose} />
      </td></tr>
    </table>
  </body>
</html>
