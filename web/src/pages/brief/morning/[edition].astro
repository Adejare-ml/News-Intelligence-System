---
/**
 * One Morning Brief edition in the browser: the email's own body, so it
 * matches what subscribers got, minus their personal links. The email's
 * "View in browser" link and the share buttons point here.
 *
 * noindex: editions name people from news reports.
 */
import Base from "../../../layouts/Base.astro";
import DigestEmail from "../../../components/email/DigestEmail.astro";
import * as data from "../../../lib/data.ts";
import { href } from "../../../lib/url.ts";
import type { EmailDigest } from "../../../lib/digest.ts";
import { morningEditions, morningUrl, whatsappUrl } from "../../../lib/morning.ts";

export function getStaticPaths() {
  return morningEditions(data.sentDigests(), data.emailDigest())
    .map((digest) => ({ params: { edition: digest.edition }, props: { digest } }));
}

const { digest } = Astro.props as { digest: EmailDigest };
const site = (Astro.site?.toString() ?? "https://auranews.pages.dev/").replace(/\/$/, "") + import.meta.env.BASE_URL.replace(/\/$/, "");
const title = `AURA Morning Brief · ${digest.date}`;
const url = morningUrl(site, digest.edition);
---
<Base title={title} description={`The Morning Brief email of ${digest.date}, as subscribers received it.`} noindex>
  <section class="wrap edition-head">
    <p class="eyebrow"><a href={href("brief/morning/")}>Morning Brief archive</a></p>
    <h1 class="h1">{digest.date}</h1>
    <div class="share" data-share data-title={title} data-url={url}>
      <button type="button" class="btn btn-ghost" data-share-native hidden>Share</button>
      <a class="btn btn-ghost" href={whatsappUrl(title, url)} target="_blank" rel="noopener noreferrer" aria-label="Share on WhatsApp (opens in a new tab)">WhatsApp</a>
      <button type="button" class="btn btn-ghost" data-share-copy hidden>Copy link</button>
      <span class="meta" data-share-status role="status"></span>
    </div>
  </section>
  <div class="edition-body">
    <DigestEmail digest={digest} site={site} web />
  </div>
</Base>
<script>
  import "../../../scripts/share.ts";
</script>

<style>
  .edition-head {
    padding-block: clamp(32px, 6vw, 72px) 20px;
  }
  .edition-head .eyebrow a {
    color: inherit;
    text-decoration: none;
  }
  .share {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-top: 20px;
  }
  .edition-body {
    padding-bottom: clamp(32px, 6vw, 72px);
  }
</style>
