---
import Base from "../../layouts/Base.astro";
import BriefArticle from "../../components/BriefArticle.astro";
import EditionList from "../../components/EditionList.astro";
import Subscribe from "../../components/Subscribe.astro";
import * as data from "../../lib/data.ts";
import { parseBrief } from "../../lib/brief.ts";
import { listEditions } from "../../lib/archive.ts";
import { lagosDate, editionName } from "../../lib/edition.ts";
import { href } from "../../lib/url.ts";

const brief = parseBrief(data.briefMarkdown());
const editions = listEditions();
const latest = editions[0];
const when = latest?.date ?? new Date();
---
<Base
  title="The Morning Brief · AURA"
  description="Today's ownership changes, board moves, contracts and regulatory actions in Nigeria, compiled from the day's reporting."
>
  <link slot="head" rel="alternate" type="application/feed+json" title="AURA Morning Brief (JSON Feed)" href={href("feed.json")} />
  <BriefArticle
    brief={brief}
    heading="What moved in Nigerian business today"
    kicker={`${editionName(when)} · ${lagosDate(when)}`}
  />
  <p class="wrap morning-link">
    <a class="btn btn-ghost" href={href("brief/morning/")}>Morning Brief emails, as sent</a>
  </p>
  <EditionList editions={editions} current={latest?.slug} />
  <Subscribe />
</Base>
<script>
  import "../../scripts/subscribe.ts";
</script>

<style>
  .morning-link {
    margin-top: clamp(32px, 6vw, 64px);
  }
</style>
