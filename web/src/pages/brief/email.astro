---
/**
 * The Morning Brief as an email: table layout and inline styles, the way
 * mail clients need it. This is the template the sender will use once
 * sending is switched on, and a preview of it in the meantime.
 */
import * as data from "../../lib/data.ts";
import { parseBrief, isQuietItem } from "../../lib/brief.ts";
import { listEditions } from "../../lib/archive.ts";
import { lagosDate } from "../../lib/edition.ts";
import { groupHoldings, describeHolding } from "../../lib/psc.ts";

const brief = parseBrief(data.briefMarkdown());
const when = listEditions()[0]?.date ?? new Date();
const site = (Astro.site?.toString() ?? "https://auranews.pages.dev/").replace(/\/$/, "") + import.meta.env.BASE_URL.replace(/\/$/, "");
const featured = groupHoldings(data.psc()).filter((h) => h.stake !== null).sort((a, b) => b.reports.length - a.reports.length)[0];
const ink = "#1b1a17";
const muted = "#6b6558";
const gold = "#9c7420";
const royal = "#1e3fae";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Morning Brief email preview · AURA</title>
  </head>
  <body style="margin:0;padding:0;background:#ece6d6;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#ece6d6;">
      <tr><td align="center" style="padding:24px 12px;">
        <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="max-width:600px;width:100%;background:#fffcf4;border-radius:14px;">
          <tr><td style={`padding:32px 32px 8px;font:600 12px/1.4 Helvetica,Arial,sans-serif;letter-spacing:2px;color:${gold};`}>
            AURA · THE MORNING BRIEF
          </td></tr>
          <tr><td style={`padding:0 32px;font:500 30px/1.15 Georgia,'Times New Roman',serif;color:${ink};`}>
            {lagosDate(when)}
          </td></tr>
          <tr><td style={`padding:10px 32px 20px;font:15px/1.6 Helvetica,Arial,sans-serif;color:${muted};`}>
            What moved in Nigerian business, ownership and public contracts since yesterday.
          </td></tr>
          {brief.sections.map((s) => (
            <>
              <tr><td style={`padding:20px 32px 6px;font:700 11px/1.4 Helvetica,Arial,sans-serif;letter-spacing:2px;text-transform:uppercase;color:${gold};border-top:1px solid #e7e0cf;`}>
                {s.title}
              </td></tr>
              {s.items.map((item) => (
                <tr><td style={`padding:8px 32px;font:15px/1.6 Helvetica,Arial,sans-serif;color:${isQuietItem(item) ? muted : ink};`}>
                  {item.lead && <strong style="font-family:Georgia,serif;font-size:17px;">{item.lead}</strong>} {item.rest}
                  {item.source && <> <a href={item.source.url} style={`color:${royal};text-decoration:none;`}>{item.source.name} →</a></>}
                </td></tr>
              ))}
            </>
          ))}
          {featured && (
            <tr><td style="padding:20px 32px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#0b0d14;border-radius:12px;">
                <tr><td style="padding:22px 24px;font:600 11px/1.4 Helvetica,Arial,sans-serif;letter-spacing:2px;color:#d4a84a;">OWNERSHIP STORY</td></tr>
                <tr><td style="padding:0 24px 22px;font:500 20px/1.3 Georgia,serif;color:#ede6d8;">
                  {featured.person} {describeHolding(featured)}.
                </td></tr>
              </table>
            </td></tr>
          )}
          <tr><td style="padding:12px 32px 28px;">
            <a href={`${site}/brief/`} style={`display:inline-block;background:${royal};color:#ffffff;padding:12px 22px;border-radius:999px;font:600 15px Helvetica,Arial,sans-serif;text-decoration:none;`}>Read the full brief</a>
          </td></tr>
          <tr><td style={`padding:18px 32px 28px;font:12px/1.6 Helvetica,Arial,sans-serif;color:${muted};border-top:1px solid #e7e0cf;`}>
            Compiled automatically from news reporting. Records are not the CAC register.
            You get this because you subscribed at {site.replace(/^https?:\/\//, "")}.
            <a href="{{unsubscribe_url}}" style={`color:${muted};`}>Unsubscribe</a>.
          </td></tr>
        </table>
      </td></tr>
    </table>
  </body>
</html>
