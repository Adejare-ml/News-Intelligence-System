---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import EditionBar from "../components/EditionBar.astro";
import BriefLead from "../components/BriefLead.astro";
import StoryGrid from "../components/StoryGrid.astro";
import OwnershipStory from "../components/OwnershipStory.astro";
import MarketStrip from "../components/MarketStrip.astro";
import Subscribe from "../components/Subscribe.astro";
import * as data from "../lib/data.ts";
import { parseBrief } from "../lib/brief.ts";
import { groupHoldings, summarise, counted, type Holding } from "../lib/psc.ts";
import { within, STORY_OF_DAY_DAYS, FRONT_PAGE_DAYS } from "../lib/freshness.ts";
import { buildFunnel } from "../lib/funnel.ts";
import { rankStories, parseTime, storiesInDay } from "../lib/stories.ts";
import { DEFAULT_ROUTES, routesFromRecords } from "../lib/routes.ts";
import { nextRunAfter, isStale, lagosTime, lagosDate, editionName } from "../lib/edition.ts";

const articles = data.articles();
const records = data.psc();
const brief = parseBrief(data.briefMarkdown());
const reports = data.reports();

// The edition's clock is the last pipeline run, not the build time, so the
// page tells the truth about how fresh it is.
const lastRun = reports
  .map((r) => parseTime(r.Generated))
  .filter((d): d is Date => d !== null)
  .sort((a, b) => b.getTime() - a.getTime())[0] ?? null;
const now = new Date();
const editionAt = lastRun ?? now;
const stories = rankStories(articles, editionAt, 9);
// One count everywhere: distinct stories published in the 24 hours before the edition.
const storiesToday = storiesInDay(articles, editionAt);

const holdings = groupHoldings(records);
const summary = summarise(holdings);

// The hero's numbers: the pipeline's yield, not a lone small count.
const historyDays = data.history().days ?? [];
const since = historyDays[0]?.date
  ? new Date(`${historyDays[0].date}T12:00:00Z`).toLocaleDateString("en-GB", { month: "short", year: "numeric", timeZone: "UTC" })
  : undefined;
const funnel = buildFunnel({
  sources: data.readJson<{ sources?: { total?: number }[] }>("sources.json", {}).sources ?? [],
  days: historyDays,
  gate: data.registerQuality(),
  holdings: summary.holdings,
  roles: summary.roles,
}, since);

// Story of the day: a current ownership claim, never a board role and never
// a withheld row (data.psc() only returns publishable rows). Recent first:
// the last 30 days, else the most recent claim there is.
const claims = counted(holdings);
const storyScore = (h: Holding) => (h.stake !== null ? 10 : 0) + h.days * 2 + h.flags.length;
const byStory = (a: Holding, b: Holding) => storyScore(b) - storyScore(a) || b.lastReported.localeCompare(a.lastReported);
const recentClaims = claims.filter((h) => within(h.lastReported, STORY_OF_DAY_DAYS, editionAt)).sort(byStory);
const featured = recentClaims[0] ?? [...claims].sort((a, b) => b.lastReported.localeCompare(a.lastReported))[0];
// The list under it: other current claims, not old records filling space.
const others = claims
  .filter((h) => h !== featured && h.person !== featured?.person && within(h.lastReported, FRONT_PAGE_DAYS, editionAt))
  .sort(byStory)
  .slice(0, 4);

const dataRoutes = routesFromRecords(records);
const routes = dataRoutes ?? DEFAULT_ROUTES;
const next = nextRunAfter(editionAt);
---
<Base>
  <Hero
    edition={editionName(editionAt)}
    dateLabel={lagosDate(editionAt)}
    summary={summary}
    funnel={funnel}
    routes={routes}
    routesFromData={Boolean(dataRoutes)}
  />
  <script type="application/json" id="globe-routes" set:html={JSON.stringify(routes)} />
  <EditionBar
    updated={lastRun}
    next={next}
    stale={isStale(lastRun, now)}
    storiesToday={storiesToday}
    updatedLabel={lastRun ? lagosTime(lastRun) : "unknown"}
    nextLabel={lagosTime(next)}
  />
  <BriefLead brief={brief} dateLabel={lagosDate(editionAt)} />
  <StoryGrid stories={stories} now={editionAt} />
  {featured && <OwnershipStory holding={featured} others={others} />}
  <MarketStrip fx={data.fx()} markets={data.markets()} weather={data.weather()} />
  <Subscribe />
</Base>

<script>
  import "../scripts/home.ts";
</script>
