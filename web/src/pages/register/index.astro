---
import Base from "../../layouts/Base.astro";
import HoldingCard from "../../components/HoldingCard.astro";
import BandScale from "../../components/BandScale.astro";
import ProcurementLedger from "../../components/ProcurementLedger.astro";
import Icon from "../../components/Icon.astro";
import * as data from "../../lib/data.ts";
import { groupHoldings, summarise, counted, registerOrder } from "../../lib/psc.ts";
import { within, REGISTER_RECENT_DAYS } from "../../lib/freshness.ts";
import { toContract, sortContracts, type ProcurementRow } from "../../lib/procurement.ts";

// Strongest claims first. Holdings not reported for a while move to
// "Earlier reports", so old records never crowd out current reporting.
const all = groupHoldings(data.psc()).sort(registerOrder);
const now = new Date();
const holdings = all.filter((h) => within(h.lastReported, REGISTER_RECENT_DAYS, now));
const earlier = all.filter((h) => !within(h.lastReported, REGISTER_RECENT_DAYS, now));
const s = summarise(all);
const shown = summarise(holdings);
const gate = data.registerQuality();
const withheld = (gate.unsourced ?? 0) + (gate.implausible ?? 0);
const companiesPerPerson = new Map<string, Set<string>>();
for (const h of all) {
  const k = h.person.toLowerCase();
  if (!companiesPerPerson.has(k)) companiesPerPerson.set(k, new Set());
  companiesPerPerson.get(k)!.add(h.company.toLowerCase());
}
const contracts = sortContracts(data.readJson<ProcurementRow[]>("procurement.json", []).map(toContract));

const filters = [
  { id: "all", label: "All records", count: holdings.length },
  { id: "stake", label: "Stake disclosed", count: shown.withStake },
  { id: "pattern", label: "Worth checking", count: shown.withPattern },
  { id: "band", label: "5–25% band", count: shown.nigeriaBand },
  { id: "multi", label: "Several companies", count: holdings.filter((h) => (companiesPerPerson.get(h.person.toLowerCase())?.size ?? 0) > 1).length },
];
---
<Base
  title="Ownership register · AURA"
  description="Persons with significant control over Nigerian companies, as reported in the news: stakes, disclosure bands and patterns worth checking."
>
  <section class="wrap intro">
    <p class="eyebrow">Persons with significant control</p>
    <h1 class="h1" data-split>The ownership register</h1>
    <p class="lede">
      Who the press reports as owning or controlling Nigerian companies, grouped from the reports
      that mention it: one card per holder and company. Disclosed stakes come first, then control
      without a stake, then board roles.
    </p>
    <dl class="kpis" data-reveal>
      <div><dt>Sourced holdings</dt><dd class="num">{s.holdings}</dd></div>
      <div><dt>People and firms</dt><dd class="num">{s.holders}</dd></div>
      <div><dt>Companies</dt><dd class="num">{s.companies}</dd></div>
      <div><dt>With a reported stake</dt><dd class="num">{s.withStake}</dd></div>
      <div><dt>Carry a CAC filing reference</dt><dd class="num">{s.filingRefRate === null ? "—" : `${Math.round(s.filingRefRate * 100)}%`}</dd></div>
    </dl>
    <p class="note">{[
      "The numbers count ownership claims only, not board roles.",
      s.roles > 0 && `${s.roles} ${s.roles === 1 ? "card is a board role" : "cards are board roles"} with no reported stake.`,
      withheld > 0 && `${withheld} of ${gate.checked} extracted ${gate.checked === 1 ? "record" : "records"} did not pass the validation gate (${[
        gate.unsourced && `${gate.unsourced} with no source`,
        gate.implausible && `${gate.implausible} judged implausible`,
      ].filter(Boolean).join(", ")}) and ${withheld === 1 ? "is" : "are"} not published.`,
    ].filter(Boolean).join(" ")}</p>
    {s.isDemo && (
      <p class="demo">Some records are illustrative seed data, not extracted reporting.</p>
    )}
  </section>

  <section class="wrap band-wrap">
    <BandScale holdings={counted(holdings)} />
  </section>

  <section class="wrap holdings" id="holdings" aria-labelledby="holdings-title">
    <h2 class="sr-only" id="holdings-title">Holdings</h2>
    <div class="controls" data-reveal>
      <div class="chips" role="group" aria-label="Filter holdings">
        {filters.map((f, i) => (
          <button type="button" class="filter" data-filter={f.id} aria-pressed={i === 0 ? "true" : "false"}>
            {f.label} <span class="count">{f.count}</span>
          </button>
        ))}
      </div>
      <label class="search">
        <Icon name="search" size={16} />
        <span class="sr-only">Search holders and companies</span>
        <input type="search" placeholder="Search a holder or company" data-register-search autocomplete="off" />
      </label>
    </div>
    <p class="meta result" aria-live="polite" data-result>{holdings.length} records</p>

    <div class="grid" data-grid>
      {holdings.map((h, i) => (
        <HoldingCard holding={h} index={i} multiCompany={(companiesPerPerson.get(h.person.toLowerCase())?.size ?? 0) > 1} />
      ))}
    </div>
    <p class="empty" hidden data-empty>
      Nothing matches. <button type="button" class="link" data-clear>Clear the filters</button>
    </p>
    {earlier.length > 0 && (
      <details class="earlier">
        <summary>Earlier reports ({earlier.length}) · not reported in the last {REGISTER_RECENT_DAYS} days</summary>
        <div class="grid">
          {earlier.map((h, i) => <HoldingCard holding={h} index={i} />)}
        </div>
      </details>
    )}
  </section>

  <div class="wrap">
    <ProcurementLedger contracts={contracts} />
  </div>
</Base>

<script>
  import "../../scripts/register.ts";
</script>

<style>
  .intro {
    padding-block: clamp(40px, 7vw, 88px) 32px;
    display: grid;
    gap: 18px;
  }
  .intro .eyebrow {
    color: var(--gold);
  }
  .kpis {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 44px;
    margin: 18px 0 0;
  }
  .kpis div {
    display: flex;
    flex-direction: column-reverse;
  }
  .kpis dt {
    font-size: 0.8rem;
    color: var(--muted);
  }
  .kpis dd {
    margin: 0;
    font-size: clamp(2rem, 3.4vw, 2.8rem);
    line-height: 1.05;
  }
  .note {
    margin: 18px 0 0;
    max-width: 62ch;
    color: var(--muted);
    font-size: 0.9rem;
  }
  .earlier {
    margin-top: 32px;
  }
  .earlier summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--text-soft);
    margin-bottom: 16px;
  }
  .demo {
    color: var(--gold);
    font-size: 0.9rem;
  }
  .band-wrap {
    padding-block: 24px 40px;
  }
  .controls {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 14px;
    align-items: center;
    position: sticky;
    top: var(--header-h);
    z-index: 5;
    padding-block: 12px;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .filter {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 36px;
    padding: 0 14px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: transparent;
    font-size: 0.86rem;
    font-weight: 560;
    color: var(--text-soft);
    cursor: pointer;
    transition: background-color var(--dur-ui) ease, color var(--dur-ui) ease, border-color var(--dur-ui) ease, transform var(--dur-press) var(--ease-out);
  }
  .filter:active {
    transform: scale(0.96);
  }
  .filter[aria-pressed="true"] {
    background: var(--text);
    color: var(--bg);
    border-color: var(--text);
  }
  .count {
    font-variant-numeric: tabular-nums;
    opacity: 0.6;
  }
  .search {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 40px;
    padding: 0 14px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: var(--surface);
    color: var(--muted);
    min-width: min(100%, 280px);
    transition: border-color var(--dur-ui) ease;
  }
  .search:focus-within {
    border-color: var(--gold);
  }
  .search input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    color: var(--text);
    font: inherit;
    font-size: 0.92rem;
    outline: none;
  }
  .result {
    margin: 8px 0 18px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 360px), 1fr));
    gap: 18px;
  }
  .empty {
    padding: 40px 0;
    color: var(--muted);
  }
  .empty .link {
    background: none;
    border: 0;
    cursor: pointer;
    font: inherit;
  }
</style>
