---
/**
 * A headline category (technology, politics), in its
 * Nigeria and Global editions, from category_news.json. Headlines link out
 * to the outlet that published them; AURA does not analyse these.
 */
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import CategoryTabs from "../../components/CategoryTabs.astro";
import * as data from "../../lib/data.ts";
import { generatedDate, publishedDate, regionLists } from "../../lib/category-news.ts";
import { relativeTime } from "../../lib/stories.ts";
import { href } from "../../lib/url.ts";
import { CATEGORIES, HEADLINE_CATEGORIES } from "../../../functions/_lib/categories.ts";

export function getStaticPaths() {
  return HEADLINE_CATEGORIES.map((category) => ({ params: { category } }));
}

const { category } = Astro.params as { category: string };
const meta = CATEGORIES.find((c) => c.id === category)!;
const news = data.categoryNews();
const lists = regionLists(news, category);
const updated = generatedDate(news.generated);
const now = updated ?? new Date();
const total = lists.reduce((n, l) => n + l.items.length, 0);
// Open on Nigeria, unless it is empty and Global is not.
const start = lists.find((l) => l.items.length)?.id ?? lists[0].id;
---
<Base title={`${meta.label} · AURA`} description={`${meta.label} headlines from Nigeria and around the world, collected by AURA four times a day.`}>
  <link slot="head" rel="alternate" type="application/rss+xml" title={`AURA · ${meta.label}`} href={href(`feeds/category/${category}.xml`)} />
  <section class="wrap intro">
    <p class="eyebrow">Headlines · {meta.label}</p>
    <h1 class="h1" data-split>{meta.label}</h1>
    <p class="lede">
      {meta.blurb}, from Nigerian and international outlets. Collected four times a day; each headline links
      to the outlet that published it.
    </p>
    <CategoryTabs current={category} />
  </section>

  <section class="wrap">
    <div class="bar" data-reveal>
      <div class="regions" role="group" aria-label="Edition" data-region-switch hidden>
        {lists.map((l) => (
          <button type="button" class="region" data-region-btn={l.id} aria-pressed={l.id === start ? "true" : "false"}>
            {l.label} <span class="count">{l.items.length}</span>
          </button>
        ))}
      </div>
      <a class="btn btn-gold inbox" href={`${href("")}?topic=${category}#subscribe`}>
        <Icon name="mail" size={16} /> Get {meta.label.toLowerCase()} in your inbox
      </a>
    </div>
    {updated && <p class="meta updated">Updated {updated.toLocaleString("en-GB", { day: "numeric", month: "short", hour: "2-digit", minute: "2-digit", timeZone: "Africa/Lagos" })} Lagos time</p>}

    {total === 0 && <p class="empty">No headlines yet. They appear after the next pipeline run.</p>}
    {lists.map((l) => (
      <section class="panel" data-region-panel={l.id} aria-label={`${l.label} headlines`}>
        <h2 class="panel-title">{l.label}</h2>
        {l.items.length ? (
          <ol class="items">
            {l.items.map((h, i) => {
              const when = publishedDate(h.published);
              return (
                <li data-reveal style={`--i:${Math.min(i, 6)}`}>
                  <a class="item" href={h.url} target="_blank" rel="noopener noreferrer">
                    <div class="text">
                      <h3 class="title">{h.title}</h3>
                      <p class="meta byline">{h.source}{when && <> · {relativeTime(when, now)}</>}</p>
                    </div>
                    <Icon name="arrowUpRight" size={18} class="out" />
                  </a>
                </li>
              );
            })}
          </ol>
        ) : (
          <p class="meta none">No {l.label === "Global" ? "international" : "Nigerian"} headlines in this run.</p>
        )}
      </section>
    ))}
  </section>
</Base>

<script>
  import "../../scripts/category.ts";
</script>

<style>
  .intro {
    padding-block: clamp(40px, 7vw, 88px) 20px;
    display: grid;
    gap: 16px;
  }
  .intro .eyebrow {
    color: var(--gold);
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    justify-content: space-between;
    padding-block: 8px;
  }
  .regions {
    display: flex;
    gap: 8px;
  }
  .regions[hidden] {
    display: none;
  }
  .region {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 34px;
    padding: 0 13px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: transparent;
    font: inherit;
    font-size: 0.85rem;
    font-weight: 560;
    color: var(--text-soft);
    cursor: pointer;
  }
  .region[aria-pressed="true"] {
    background: var(--text);
    color: var(--bg);
    border-color: var(--text);
  }
  @media (forced-colors: active) {
    .region[aria-pressed="true"] {
      outline: 2px solid Highlight;
      outline-offset: 2px;
    }
  }
  .count {
    opacity: 0.6;
    font-variant-numeric: tabular-nums;
  }
  .inbox {
    gap: 8px;
  }
  .updated {
    margin: 4px 0 8px;
  }
  .panel {
    margin-block: 20px 40px;
  }
  .panel[hidden] {
    display: none;
  }
  .panel-title {
    margin: 0 0 8px;
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .items {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .item {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 16px;
    align-items: center;
    padding: 16px 4px;
    border-bottom: 1px solid var(--line);
    color: inherit;
    text-decoration: none;
  }
  .item:hover .title {
    color: var(--gold);
  }
  .title {
    margin: 0 0 4px;
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 500;
    line-height: 1.35;
    transition: color var(--dur-ui) ease;
  }
  .byline {
    margin: 0;
  }
  .item :global(.out) {
    color: var(--muted);
  }
  .empty,
  .none {
    color: var(--muted);
  }
  @media (max-width: 560px) {
    .inbox {
      width: 100%;
      justify-content: center;
    }
  }
</style>
