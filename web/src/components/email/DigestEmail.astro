---
/**
 * The Morning Brief email body, from the pipeline's edition data
 * (email_digest.json). Table layout and inline styles for mail clients.
 *
 * Reads in full without a click: an overview, AURA's analysis kept apart from
 * reported fact, then a card per story with what happened, the key facts, how
 * the story moved and why it matters. Each article is linked once, by outlet
 * name. Nothing here is per-recipient except {{unsubscribe_url}} and
 * {{preferences_url}}; the reader's chosen category sections go in at
 * SECTIONS_SLOT when the brief is sent.
 *
 * `web` renders the same edition for the public archive (/brief/morning/):
 * no "View in browser" link (it is the browser copy), a correction link in
 * place of "Reply to this email" (there is no inbox to reply from), and a
 * sign-up link where the email has the reader's personal unsubscribe and
 * topic links.
 */
import type { EmailDigest } from "../../lib/digest.ts";
import Card from "./DigestCard.astro";
import { plural } from "../../lib/digest.ts";
import { viewInBrowserUrl } from "../../lib/morning.ts";
import { correctionUrl } from "../../lib/corrections.ts";
import { ink, muted, soft, gold, royal, alertRed, rule, sans, serif, SECTIONS_SLOT } from "./theme.ts";

interface Props {
  digest: EmailDigest;
  site: string;
  web?: boolean;
}
const { digest: d, site, web = false } = Astro.props;


const s = d.stats;
const alertCards = d.cards.filter((c) => c.alert);
const otherCards = d.cards.filter((c) => !c.alert);
const cite = (ns: number[], outlets: string[]) =>
  ns.length === 1 ? `[${ns[0]} · ${outlets[0]}]` : `[${ns.join(", ")}]`;
const coverage = d.since
  ? `added since the last brief (${d.since})`
  : "from the last 24 hours";
const glance = [
  plural(s.risk_alerts, "risk alert") + " (High/Critical)",
  plural(s.public_money, "public-money decision"),
  plural(s.appointments, "appointment"),
  plural(s.ownership, "ownership and control report"),
].join(" · ");

// Outlook for Windows ignores max-width and stretches a width:100% table
// across the reading pane; a fixed 600px ghost table holds it.
const msoOpen = '<!--[if mso]><table role="presentation" width="600" align="center" cellpadding="0" cellspacing="0"><tr><td><![endif]-->';
const msoClose = "<!--[if mso]></td></tr></table><![endif]-->";

const label = `padding:22px 32px 6px;font:700 11px/1.4 ${sans};letter-spacing:2px;text-transform:uppercase;color:${gold};border-top:1px solid ${rule};`;
const body = `font:15px/1.6 ${sans};color:${ink};`;
const small = `font:13px/1.55 ${sans};color:${muted};`;
const link = `color:${royal};text-decoration:none;font-weight:600;`;
---
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#ece6d6;">
  <tr><td align="center" style="padding:24px 12px;">
    <Fragment set:html={msoOpen} />
    <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="max-width:600px;width:100%;background:#fffcf4;border-radius:14px;">
      {!web && <tr><td align="right" style={`padding:14px 32px 0;${small}font-size:12px;`}><a href={viewInBrowserUrl(site, d)} style={`color:${muted};`}>View in browser</a></td></tr>}
      <tr><td style={`padding:${web ? 32 : 14}px 32px 8px;font:600 12px/1.4 ${sans};letter-spacing:2px;color:${gold};`}>AURA · THE MORNING BRIEF</td></tr>
      <tr><td style={`padding:0 32px;font:500 30px/1.15 ${serif};color:${ink};`}>{d.date}</td></tr>
      <tr><td style={`padding:10px 32px 4px;${small}`}>
        {s.stories > 0
          ? `${plural(s.reports, "report")} grouped into ${plural(s.stories, "story", "stories")} from ${plural(s.outlets, "outlet")}, ${coverage}.`
          : `No new stories ${coverage}.`}
      </td></tr>
      <tr><td style={`padding:4px 32px 20px;font:600 13px/1.6 ${sans};color:${ink};`}>
        {glance}
        {d.also_more > 0 && <><br /><span style={`font-weight:400;color:${muted};`}>Counts cover the whole edition, including {plural(d.also_more, "story", "stories")} listed only on the site.</span></>}
        {d.nothing_in.length > 0 && <><br /><span style={`font-weight:400;color:${muted};`}>Nothing reported in this edition: {d.nothing_in.join(", ")}.</span></>}
      </td></tr>

      {d.overview.length > 0 && (<>
        <tr><td style={label}>The day in brief · what was reported</td></tr>
        <tr><td style="padding:6px 32px 8px;">
          <ul style={`margin:0;padding:0 0 0 18px;${body}`}>
            {d.overview.map((o) => (
              <li style="margin:0 0 8px;">{o.text} <span style={`white-space:nowrap;font:600 12px ${sans};color:${muted};`}>[{o.card} · {o.outlet}]</span></li>
            ))}
          </ul>
        </td></tr>
      </>)}

      {d.insights.length > 0 && (<>
        <tr><td style={label}>What it means · AURA analysis, not reported fact</td></tr>
        <tr><td style="padding:6px 32px 8px;">
          <ul style={`margin:0;padding:0 0 0 18px;font:14px/1.6 ${sans};color:${soft};`}>
            {d.insights.map((i) => (
              <li style="margin:0 0 8px;"><strong style={`color:${ink};`}>{i.label}</strong> <span style={`font:600 12px ${sans};color:${muted};`}>{cite(i.cards, i.outlets)}</span>: {i.text}</li>
            ))}
          </ul>
        </td></tr>
      </>)}

      {alertCards.length > 0 && (<>
        <tr><td style={label.replace(`color:${gold}`, `color:${alertRed}`)}>Risk alerts</td></tr>
        {alertCards.map((c) => <Card c={c} />)}
      </>)}
      {otherCards.length > 0 && (<>
        <tr><td style={label}>Top stories</td></tr>
        {otherCards.map((c) => <Card c={c} />)}
      </>)}

      {d.also.length > 0 && (<>
        <tr><td style={label}>Also today</td></tr>
        <tr><td style="padding:6px 32px 8px;">
          {d.also.map((a) => (
            <p style={`margin:0 0 8px;font:14px/1.55 ${sans};color:${ink};`}>
              <span style={`font:700 11px ${sans};letter-spacing:1px;text-transform:uppercase;color:${muted};`}>{a.n} · {a.theme}</span><br />
              {a.text} <a href={a.url} style={link}>{a.outlet} ↗</a>
            </p>
          ))}
          {d.also_more > 0 && <p style={`margin:0;${small}`}><a href={`${site}/news/`} style={link}>+{d.also_more} more on the site ↗</a></p>}
        </td></tr>
      </>)}

      {d.psc.length > 0 && (<>
        <tr><td style={label}>Ownership &amp; control</td></tr>
        <tr><td style="padding:6px 32px 8px;">
          <p style={`margin:0 0 8px;${small}`}>A PSC (person with significant control) owns or controls 5% or more of a Nigerian company under CAMA 2020.</p>
          {d.psc.map((p) => (
            <p style={`margin:0 0 8px;font:14px/1.55 ${sans};color:${ink};`}>
              {p.text} · reported by {p.outlet}{p.date && `, ${p.date}`} · not verified with CAC (Corporate Affairs Commission) records ·{" "}
              <a href={p.url} style={link}>Read the report ↗</a>
            </p>
          ))}
          {(d.psc_more ?? 0) > 0 && <p style={`margin:0;${small}`}><a href={`${site}/register/`} style={link}>+{d.psc_more} more in the ownership register ↗</a></p>}
        </td></tr>
      </>)}

      {d.terms.length > 0 && (<>
        <tr><td style={label}>Terms used today</td></tr>
        <tr><td style={`padding:6px 32px 8px;${small}`}>
          {d.terms.map((t, i) => (<>{i > 0 && " · "}<strong style={`color:${soft};`}>{t.term}</strong>: {t.meaning}</>))}
        </td></tr>
      </>)}

      <Fragment set:html={SECTIONS_SLOT} />
      <tr><td style={`padding:20px 32px 28px;${small}border-top:1px solid ${rule};`}>
        AURA reads Nigerian news outlets four times a day. An AI model extracts what each report says, and rules
        check each line against its source and drop anything that does not match. Facts are as reported by the
        outlet named, not independently verified. Lines marked AURA analysis are interpretation. Ownership items
        are press reports, not CAC records. Spot an error?{" "}
        {web ? <a href={correctionUrl(`Morning Brief ${d.edition}`)} style={link}>Request a correction</a> : "Reply to this email"}.
        <br /><br />
        {d.engines.extraction.length > 0 && <>Engine: extraction {d.engines.extraction.join(", ")}{d.engines.digest ? ` · overview ${d.engines.digest}` : " · overview from stored text"}<br /></>}
        <a href={`${site}/brief/`} style={link}>Full brief, archive and registers ↗</a>
        <br />
        {web ? <a href={`${site}/brief/#subscribe`} style={link}>Sign up for the Morning Brief ↗</a> : <>
          You get this because you subscribed at {site.replace(/^https?:\/\//, "")}.{" "}
          <a href="{{preferences_url}}" style={`color:${muted};`}>Change topics</a>{" · "}
          <a href="{{unsubscribe_url}}" style={`color:${muted};`}>Unsubscribe</a>.
        </>}
      </td></tr>
    </table>
    <Fragment set:html={msoClose} />
  </td></tr>
</table>
