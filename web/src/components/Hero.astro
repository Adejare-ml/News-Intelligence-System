---
import Icon from "./Icon.astro";
import { href } from "../lib/url.ts";
import type { RegisterSummary } from "../lib/psc.ts";
import type { FunnelStep } from "../lib/funnel.ts";

interface Props {
  edition: string;
  dateLabel: string;
  summary: RegisterSummary;
  funnel: FunnelStep[];
  routes: { label: string }[];
  routesFromData: boolean;
}

const { edition, dateLabel, summary, funnel, routes, routesFromData } = Astro.props;
---
<section class="hero" data-hero>
  <div class="wrap hero-grid">
    <div class="copy">
      <p class="edition">
        <span class="pulse" aria-hidden="true"></span>
        <span>{edition}</span>
        <span class="sep" aria-hidden="true">·</span>
        <span class="date">{dateLabel}</span>
      </p>
      <h1 class="h1 title" data-split data-reveal-manual>
        Who really controls <em>Nigeria’s</em> companies?
      </h1>
      <p class="lede">
        Hidden owners are how public money quietly disappears. AURA reads Nigeria’s business news four
        times a day and maps who controls what.
      </p>
      <div class="ctas">
        <a class="btn btn-primary" href={href("brief/")}>
          Read today’s brief <Icon name="arrowRight" size={18} />
        </a>
        <a class="btn btn-ghost" href={href("register/#holdings")}>Explore the register</a>
      </div>
    </div>

    <figure class="globe-wrap" aria-labelledby="globe-caption">
      <div class="globe-stage">
        <canvas
          class="globe"
          data-globe
          data-illustrative={routesFromData ? "0" : "1"}
          role="img"
          aria-label={`Globe showing routes from Lagos and Abuja to ${routes.map((r) => r.label).join(", ")}`}
        ></canvas>
        <p class="drag-hint" aria-hidden="true">Drag to spin</p>
      </div>
      <figcaption id="globe-caption">
        <span class="num routes-count">
          <span>{summary.offshore}</span> of {summary.holdings} holdings route offshore so far
        </span>
        <span class="caption-text">
          {routesFromData
            ? "The lines are the jurisdictions named in the ownership chains AURA has recorded."
            : `None recorded yet. The dashed lines are the ${routes.length} jurisdictions AURA watches for, not findings.`}
        </span>
      </figcaption>
    </figure>

    <!-- The numbers are part of the first screen, never faded or counted up:
         each one opens the page that shows where it comes from. -->
    <div class="funnel-wrap">
      <p class="funnel-title">From newsroom to register <span>· tap a number to see where it comes from</span></p>
      <ol class="kpis">
        {funnel.map((k) => (
          <li class="kpi">
            <a href={href(k.link)}>
              <span class="num value">{k.value.toLocaleString("en-GB")}</span>
              <span class="label">{k.label}</span>
              <span class="hint">{k.hint}</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(16px, min(3.5vw, 4.5svh), 44px) clamp(28px, 4vw, 48px);
    overflow: clip;
    isolation: isolate;
  }
  /* A wash of royal blue from the globe side and a whisper of gold. */
  .hero::before {
    content: "";
    position: absolute;
    inset: -20% -10% 0 30%;
    z-index: -1;
    background:
      radial-gradient(48% 52% at 62% 46%, rgba(47, 85, 212, 0.16), transparent 70%),
      radial-gradient(30% 30% at 70% 70%, rgba(212, 168, 74, 0.07), transparent 70%);
    pointer-events: none;
  }
  :global(:root[data-theme="light"]) .hero::before {
    background:
      radial-gradient(48% 52% at 62% 46%, rgba(30, 63, 174, 0.1), transparent 70%),
      radial-gradient(30% 30% at 70% 70%, rgba(156, 116, 32, 0.08), transparent 70%);
  }

  /* Desktop: copy | globe on the first row, the numbers across the second,
     sized so the whole block fits a laptop's first screen. */
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    grid-template-areas:
      "copy globe"
      "funnel funnel";
    column-gap: clamp(24px, 4vw, 56px);
    row-gap: clamp(18px, 2.5vw, 28px);
    align-items: center;
  }
  .copy { grid-area: copy; }
  .globe-wrap { grid-area: globe; }
  .funnel-wrap { grid-area: funnel; }

  .edition {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 16px;
    padding: 6px 14px 6px 10px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: var(--surface-glass);
    font-size: 0.78rem;
    font-weight: 560;
    letter-spacing: 0.04em;
    color: var(--text-soft);
  }
  .edition .sep {
    color: var(--faint);
  }
  .pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--gold);
    box-shadow: 0 0 0 0 rgba(212, 168, 74, 0.5);
    animation: breathe 6s var(--ease-in-out) infinite;
  }
  @keyframes breathe {
    0%, 100% { box-shadow: 0 0 0 0 rgba(212, 168, 74, 0.45); }
    50% { box-shadow: 0 0 0 7px rgba(212, 168, 74, 0); }
  }

  .title {
    max-width: 13ch;
    margin: 0 0 16px;
    /* Sized by width and by height, so short laptop screens still fit the
       numbers below it on the first screen. */
    font-size: clamp(2.4rem, min(5vw, 8.6svh), 4.6rem);
    text-wrap: balance;
  }
  .title em {
    font-style: italic;
    font-weight: 460;
    color: var(--gold);
  }
  .lede {
    margin: 0 0 22px;
    max-width: 46ch;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .funnel-title {
    margin: 0 0 10px;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .funnel-title span {
    text-transform: none;
    letter-spacing: 0;
    font-weight: 500;
    color: var(--faint);
  }
  .kpis {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    margin: 0;
    padding: 0;
    border-radius: var(--radius-m);
    overflow: hidden;
    background: var(--line);
    border: 1px solid var(--line);
  }
  .kpi {
    position: relative;
    background: var(--bg);
  }
  .kpi a {
    display: grid;
    gap: 4px;
    height: 100%;
    padding: 16px 18px 14px;
    transition: background-color var(--dur-ui) ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .kpi a:hover {
      background: var(--surface);
    }
    .kpi a:hover .label {
      color: var(--royal-ink);
    }
  }
  .kpi a:focus-visible {
    outline: 2px solid var(--royal-ink);
    outline-offset: -2px;
  }
  .value {
    font-size: clamp(1.7rem, 2.6vw, 2.3rem);
    line-height: 1;
    color: var(--text);
  }
  /* The last step is the register: what survived. */
  .kpi:last-child .value {
    color: var(--gold);
  }
  .kpi:not(:last-child)::after {
    content: "›";
    position: absolute;
    right: 10px;
    top: 14px;
    font-size: 1.1rem;
    color: var(--faint);
    pointer-events: none;
  }
  .label {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--text-soft);
    transition: color var(--dur-ui) ease;
  }
  .hint {
    font-size: 0.74rem;
    line-height: 1.35;
    color: var(--muted);
  }

  .globe-wrap {
    margin: 0;
    position: relative;
  }
  .globe-stage {
    position: relative;
    aspect-ratio: 1;
    width: 100%;
    /* Never taller than the room the first screen leaves for it. */
    max-width: min(460px, 52svh);
    margin-inline: auto;
  }
  .globe {
    width: 100%;
    height: 100%;
    cursor: grab;
    touch-action: pan-y;
  }
  .globe:global(.is-dragging) {
    cursor: grabbing;
  }
  .drag-hint {
    position: absolute;
    right: 8%;
    bottom: 10%;
    margin: 0;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--faint);
    opacity: 0;
    transition: opacity 600ms ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .globe-stage:hover .drag-hint {
      opacity: 1;
    }
  }
  figcaption {
    display: grid;
    gap: 2px;
    justify-items: center;
    text-align: center;
    margin-top: -6px;
  }
  .routes-count {
    font-size: 1.05rem;
    color: var(--gold);
  }
  .caption-text {
    font-size: 0.8rem;
    color: var(--muted);
    max-width: 42ch;
  }

  /* Short laptop screens: drop the hint lines so the numbers stay in view. */
  @media (min-width: 981px) and (max-height: 760px) {
    .hint {
      display: none;
    }
    .edition {
      margin-bottom: 12px;
    }
    .lede {
      margin-bottom: 18px;
    }
  }

  /* Tablets and phones: the question, the numbers, the buttons, then the globe. */
  @media (max-width: 980px) {
    .hero-grid {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 18px;
    }
    .copy {
      display: contents;
    }
    .edition { order: 1; align-self: flex-start; margin: 0; }
    .title { order: 2; margin: 0; }
    .lede { order: 3; margin: 0; }
    .funnel-wrap { order: 4; }
    .ctas { order: 5; }
    .globe-wrap { order: 6; }
    .title {
      max-width: 14ch;
    }
    .globe-stage {
      max-width: min(400px, 80vw);
    }
  }
  @media (max-width: 640px) {
    .title {
      font-size: clamp(2.2rem, 10vw, 2.8rem);
    }
    .lede {
      font-size: 1rem;
    }
    .funnel-title span {
      display: none;
    }
    .kpis {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .kpi:nth-child(2n)::after {
      content: none;
    }
    .kpi a {
      padding: 14px 14px 12px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pulse {
      animation: none;
    }
  }
</style>
