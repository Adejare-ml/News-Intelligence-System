---
import Icon from "./Icon.astro";
import Chain from "./Chain.astro";
import ReportTimeline from "./ReportTimeline.astro";
import { href } from "../lib/url.ts";
import { slugify } from "../lib/entity-key.ts";
import type { Holding } from "../lib/psc.ts";
import { describeHolding } from "../lib/psc.ts";

interface Props {
  holding: Holding;
  others: Holding[];
}
const { holding, others } = Astro.props;
---
<section class="section ownership" aria-labelledby="own-title">
  <div class="wrap">
    <div class="section-head">
      <div>
        <p class="eyebrow">Ownership story of the day</p>
        <h2 class="h2" id="own-title" data-split>
          {holding.person} {describeHolding(holding)}.
        </h2>
      </div>
    </div>

    <div class="panel" data-reveal data-chain>
      <Chain holding={holding} />
      <div class="timeline-wrap"><ReportTimeline holding={holding} /></div>

      <div class="foot">
        {holding.band && <span class="chip chip-gold">CAMA band {holding.band.label}</span>}
        {holding.flags.slice(0, 2).map((f) => <span class:list={["chip", f.severity === "high" ? "chip-crimson" : "chip-royal"]}>{f.title}</span>)}
        <span class="meta src">Extracted from news reporting · not a CAC filing</span>
        <a class="link" href={href(`entity/${slugify(holding.person)}/`)}>Follow {holding.person.split(" ")[0]} <Icon name="arrowRight" size={16} /></a>
      </div>
    </div>

    {others.length > 0 && (
      <ul class="others">
        {others.map((h, i) => (
          <li data-reveal style={`--i:${i}`}>
            <a href={href(`entity/${slugify(h.person)}/`)}>
              <span class="o-name">{h.person}</span>
              <span class="o-desc">{describeHolding(h)}</span>
              <span class:list={["o-stake", "num", { muted: h.stake === null }]}>{h.stake === null ? "—" : h.stakeLabel}</span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</section>

<style>
  .ownership h2 {
    max-width: 22ch;
    text-wrap: balance;
  }
  .panel {
    position: relative;
    padding: clamp(24px, 4vw, 48px);
    border-radius: var(--radius-l);
    border: 1px solid var(--line);
    background:
      radial-gradient(70% 120% at 100% 0%, rgba(212, 168, 74, 0.08), transparent 60%),
      radial-gradient(60% 100% at 0% 100%, rgba(47, 85, 212, 0.1), transparent 60%),
      var(--surface);
    box-shadow: var(--shadow-2);
    overflow: hidden;
  }

  .timeline-wrap {
    margin-top: clamp(32px, 5vw, 52px);
  }

  .foot {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 12px;
    align-items: center;
  }
  .src {
    margin-left: 4px;
  }
  .foot .link {
    margin-left: auto;
  }

  .others {
    list-style: none;
    margin: 20px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 32px;
  }
  .others a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas: "name stake" "desc stake";
    gap: 2px 16px;
    padding: 16px 4px;
    border-bottom: 1px solid var(--line);
    transition: background-color var(--dur-ui) ease, padding var(--dur-ui) var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .others a:hover {
      padding-inline: 12px;
      background: var(--surface);
    }
  }
  .o-name {
    grid-area: name;
    font-weight: 600;
  }
  .o-desc {
    grid-area: desc;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .o-stake {
    grid-area: stake;
    align-self: center;
    font-size: 1.35rem;
    color: var(--gold);
  }
  .o-stake.muted {
    color: var(--faint);
  }

  @media (max-width: 720px) {
    .others {
      grid-template-columns: 1fr;
    }
    .foot .link {
      margin-left: 0;
    }
  }
</style>
