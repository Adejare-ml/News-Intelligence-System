---
import Icon from "./Icon.astro";
import type { Story } from "../lib/stories.ts";
import { relativeTime } from "../lib/stories.ts";
import { imageSrc, href } from "../lib/url.ts";
import { logoFor } from "../lib/logos.ts";

interface Props {
  story: Story;
  now: Date;
  size?: "lead" | "feature" | "compact";
  index?: number;
}
const { story, now, size = "compact", index = 0 } = Astro.props;
const when = relativeTime(story.published, now);
const riskChip = story.riskLevel === "Critical" ? "chip-crimson" : story.riskLevel === "High" ? "chip-gold" : "";
const showRisk = story.riskLevel === "Critical" || story.riskLevel === "High";
const c = story.cover;
// A card shows the publisher's photo, else the logo of the organisation the
// story is about (fetched from its own site at deploy time), else nothing
// pictorial at all: a typographic card, never generated artwork.
const logo = logoFor([story.title, story.entities.join(" | ")]);
const logoBanner = !story.image && logo && size !== "compact";
const typeOnly = !story.image && !logoBanner;
---
<article class:list={["story", size, { "type-only": typeOnly, "has-logo": logoBanner }, `tone-${c.tone}`]} data-reveal data-tilt style={`--i:${index}`}>
  <a class="hit" href={story.url} rel="noopener noreferrer" target="_blank" aria-label={`${story.title} (${story.publisher}, opens in a new tab)`}></a>
  {!typeOnly && <div class="media">
    {logo ? (
      <div class="logo-banner" aria-hidden="true">
        <span class="logo-tile"><img src={href(logo.path)} alt="" width="72" height="72" loading="lazy" decoding="async" /></span>
        <span class="logo-name">{logo.name}</span>
      </div>
    ) : (
      <div class:list={["cover", `tone-${c.tone}`]} style={`--angle:${c.angle}deg`} aria-hidden="true"></div>
    )}
    {story.image && (
      <img
        src={imageSrc(story.image)}
        alt=""
        loading={size === "lead" ? "eager" : "lazy"}
        decoding="async"
        referrerpolicy="no-referrer"
        data-story-img
      />
    )}
  </div>}
  <div class="body">
    <div class="tags">
      {typeOnly && logo && (
        <span class="logo-chip" title={logo.name}><img src={href(logo.path)} alt="" width="20" height="20" loading="lazy" decoding="async" /></span>
      )}
      <span class="chip">{story.category}</span>
      {showRisk && <span class:list={["chip", riskChip]}><span class="dot"></span>{story.riskLevel} risk</span>}
    </div>
    <h3 class="h3 title">{story.title}</h3>
    {size !== "compact" && story.summary && <p class="summary">{story.summary}</p>}
    <p class="meta byline">
      <span class="publisher">{story.publisher}</span>
      {when && <><span aria-hidden="true">·</span><time datetime={story.published?.toISOString()}>{when}</time></>}
      <Icon name="arrowUpRight" size={14} class="out" />
    </p>
  </div>
</article>

<style>
  .story {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    border-radius: var(--radius-l);
    background: var(--surface);
    border: 1px solid var(--line);
    overflow: hidden;
    transform-style: preserve-3d;
    will-change: transform;
    transition: border-color var(--dur-ui) ease, box-shadow 400ms var(--ease-out);
    box-shadow: var(--shadow-1);
  }
  .story:active {
    transform: scale(0.985);
  }
  @media (hover: hover) and (pointer: fine) {
    .story:hover {
      border-color: var(--line-strong);
      box-shadow: var(--shadow-2);
    }
    .story:hover .media > img,
    .story:hover .cover {
      transform: scale(1.035);
    }
    .story:hover .title {
      color: var(--text);
    }
    .story:hover .out {
      transform: translate(2px, -2px);
      color: var(--gold);
    }
  }
  .hit {
    position: absolute;
    inset: 0;
    z-index: 2;
    border-radius: inherit;
  }
  .hit:focus-visible {
    outline-offset: -3px;
  }

  .media {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--surface-2);
  }
  /* The lead runs full width: image left, story right. */
  .lead {
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    grid-template-rows: auto;
  }
  .lead .media {
    aspect-ratio: auto;
    min-height: 340px;
  }
  .lead .body {
    padding: clamp(22px, 3vw, 40px);
    justify-content: center;
    gap: 14px;
  }
  @media (max-width: 860px) {
    .lead {
      grid-template-columns: 1fr;
    }
    .lead .media {
      min-height: 0;
      aspect-ratio: 16 / 10;
    }
    .lead .body {
      padding: 18px 20px 20px;
    }
  }
  .media > img,
  .cover {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transition: transform 900ms var(--ease-out);
  }
  .media > img {
    object-fit: cover;
  }
  /* Images arrive with a reveal from the bottom edge. */
  :global(.js) .media > img {
    clip-path: inset(100% 0 0 0);
    transition: clip-path 900ms var(--ease-out), transform 900ms var(--ease-out);
  }
  :global(.js) .media > img:global(.is-loaded) {
    clip-path: inset(0 0 0 0);
  }

  /* Behind a photo (shown if it fails to load): a quiet tone, no artwork. */
  .cover {
    --c1: #1b2440;
    --c2: #0d1120;
    position: absolute;
    inset: 0;
    background: linear-gradient(var(--angle), var(--c1), var(--c2));
  }
  .tone-royal {
    --c1: #24325f;
    --c2: #0f1736;
  }
  .tone-gold {
    --c1: #3d321a;
    --c2: #17130a;
  }
  .tone-crimson {
    --c1: #3f2420;
    --c2: #140c0b;
  }
  .tone-ink {
    --c1: #232a40;
    --c2: #0b0d14;
  }

  /* The organisation the story is about, by its own logo. */
  .logo-banner {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 12px;
    background:
      radial-gradient(70% 80% at 50% 40%, color-mix(in srgb, var(--surface) 70%, var(--royal) 8%), var(--surface-2));
  }
  .logo-tile {
    display: grid;
    place-items: center;
    width: 112px;
    height: 112px;
    border-radius: 24px;
    background: #fff;
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.28);
  }
  .logo-tile img {
    width: 72px;
    height: 72px;
    object-fit: contain;
  }
  .lead .logo-tile {
    width: 148px;
    height: 148px;
    border-radius: 32px;
  }
  .lead .logo-tile img {
    width: 100px;
    height: 100px;
  }
  .logo-name {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .logo-chip {
    display: inline-grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 7px;
    background: #fff;
  }
  .logo-chip img {
    width: 20px;
    height: 20px;
    object-fit: contain;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 18px 20px 20px;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .title {
    color: var(--text);
    text-wrap: pretty;
    transition: color var(--dur-ui) ease;
  }
  .lead .title {
    font-size: clamp(1.6rem, 2.8vw, 2.4rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
  }
  .feature .title {
    font-size: clamp(1.25rem, 1.8vw, 1.5rem);
  }
  .compact .title {
    font-size: 1.08rem;
    line-height: 1.25;
    font-family: var(--font-ui);
    font-weight: 600;
    letter-spacing: -0.005em;
  }
  .summary {
    margin: 0;
    color: var(--text-soft);
    font-size: 0.95rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .lead .summary {
    font-size: 1.05rem;
    -webkit-line-clamp: 4;
  }
  .byline {
    margin: auto 0 0;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .publisher {
    color: var(--text-soft);
    font-weight: 560;
  }
  .byline :global(.out) {
    margin-left: auto;
    transition: transform var(--dur-ui) var(--ease-out), color var(--dur-ui) ease;
  }

  .compact {
    grid-template-columns: 1fr;
  }
  .compact .media {
    aspect-ratio: 2 / 1;
  }

  /* Typographic card: no picture, a toned rule and the headline in the display face. */
  .type-only {
    grid-template-rows: 1fr;
    --accent: var(--line-strong);
  }
  .type-only.tone-royal { --accent: var(--royal-ink); }
  .type-only.tone-gold { --accent: var(--gold); }
  .type-only.tone-crimson { --accent: var(--crimson); }
  .type-only::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 3px;
    background: var(--accent);
    opacity: 0.85;
  }
  .type-only .title {
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 1.6vw, 1.4rem);
    line-height: 1.22;
    letter-spacing: -0.01em;
  }
  .type-only.feature .title {
    font-size: clamp(1.3rem, 2vw, 1.7rem);
  }
  /* A lead with no photo and no logo is a full-width headline card. */
  .lead.type-only {
    grid-template-columns: 1fr;
  }
  .lead.type-only .body {
    padding: clamp(26px, 4vw, 52px);
    max-width: 62rem;
  }
  .lead.type-only .title {
    font-size: clamp(1.8rem, 3.4vw, 2.8rem);
    line-height: 1.12;
  }
</style>
