# News Intelligence System - Environment Variables
# Copy this file to .env and fill in your values.
#
# Kept in step with backend/app/core/config.py (Settings) -- every variable
# the code reads appears here, grouped the same way. The pipeline runs with
# nothing but one LLM key; everything else degrades gracefully.

# --- LLM providers (at least ONE key required to run the pipeline) ---------
# Primary report generator
GEMINI_API_KEY=
# Pin a specific model; blank uses the rolling default resolved in llm.py
GEMINI_MODEL=
# NVIDIA NIM: extraction + report fallback (vendor/model format for models)
NVIDIA_API_KEY=
NVIDIA_MODEL=
NVIDIA_MODEL_FALLBACK=
# Ollama (cloud or self-hosted). The cascade only attempts Ollama when the
# host or key is explicitly set.
OLLAMA_HOST=
OLLAMA_API_KEY=
OLLAMA_MODEL=gemma4:31b-cloud
# Last-resort report fallback
OPENAI_API_KEY=

# --- News source keys (all optional -- Google News RSS works without any) --
NEWSAPI_KEY=
NEWSAPI_KEY_2=
GNEWS_KEY=
MEDIASTACK_KEY=
NEWSDATA_KEY=
GUARDIAN_API_KEY=

# --- Google Sheets database (optional -- falls back to local Excel) --------
# The service-account JSON, as a single line, and the target spreadsheet id.
GOOGLE_SERVICE_ACCOUNT_JSON=
SPREADSHEET_ID=

# --- Alerts (optional) ------------------------------------------------------
# A Slack incoming-webhook or Discord webhook URL; each run's high-risk
# articles are POSTed to it. Unset = no alerts.
ALERT_WEBHOOK_URL=

# --- Pipeline behavior ------------------------------------------------------
# Seed illustrative PSC rows when the register is empty (clearly labelled)
SEED_DEMO_PSC=false
# Pad a thin cycle (<10 real articles) with synthetic, clearly-marked ones
SEED_DEMO_ARTICLES=false
# Permit degraded keyword-heuristic extraction when every LLM fails
ALLOW_HEURISTIC_FALLBACK=false
# One in N analysed articles is sampled into evals/corpus/ for labelling
EVAL_CAPTURE_RATE=10

# --- DSPy extraction (optional, opt-in) -------------------------------------
USE_DSPY_EXTRACTION=false
# Which configured provider DSPy targets: "ollama" | "nvidia"
DSPY_PROVIDER=ollama
# GEPA optimiser budget -- used only by scripts/optimise_extraction.py
GEPA_MAX_METRIC_CALLS=150
GEPA_REFLECTION_MODEL=

# --- NLP ---------------------------------------------------------------------
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# ============================================================================
# Docker / API mode only (NOT used by the serverless pipeline or dashboard)
# ============================================================================

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=news_intel
DATABASE_URL=postgresql://postgres:your_secure_password_here@db:5432/news_intel

# Redis
REDIS_URL=redis://redis:6379/0

# Authentication (REQUIRED for the Docker/API mode - the API refuses to start without it)
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Leave blank here on purpose: a committed placeholder would be a publicly
# known signing key, and the API rejects known placeholder values.
JWT_SECRET=
# Admin user is only seeded when this is set (no default credentials exist)
ADMIN_SEED_EMAIL=admin@newsintel.com
ADMIN_SEED_PASSWORD=

# Application
ENVIRONMENT=development
