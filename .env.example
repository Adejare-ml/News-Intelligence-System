# News Intelligence System - Environment Variables
# Copy this file to .env and fill in your values

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=news_intel
DATABASE_URL=postgresql://postgres:your_secure_password_here@db:5432/news_intel

# Redis
REDIS_URL=redis://redis:6379/0

# Authentication (REQUIRED for the Docker/API mode - the API refuses to start without it)
JWT_SECRET=generate_a_secure_random_string_here
# Admin user is only seeded when this is set (no default credentials exist)
ADMIN_SEED_EMAIL=admin@newsintel.com
ADMIN_SEED_PASSWORD=

# Application
ENVIRONMENT=development

# News API Keys (get from respective providers)
NEWSAPI_KEY=
GNEWS_KEY=
MEDIASTACK_KEY=
NEWSDATA_KEY=
GUARDIAN_API_KEY=